# Deployment to Google Cloud: run `just` to list the recipes.
#
# On your computer:   just mgmt-start, just mgmt, just keygen, just images <registry>, just prometheus, just mgmt-stop
# Inside mgmt:        just infra, just cluster, just platform, just app (or just all), just stop, just start,
#                     just snapshot, just compare, just destroy, just destroy-data
#
# Running everything locally, in Docker, is a different set of recipes: see the justfile in the project root.

set shell := ["bash", "-euo", "pipefail", "-c"]

repo := justfile_directory() / ".."

default:
    @just --list

# Build and start the management container, with the repository mounted at /root/g17
mgmt-start:
    docker build -t g17-mgmt mgmt
    docker run --rm -d --name g17-mgmt --hostname mgmt -v "{{repo}}:/root/g17" g17-mgmt

# Open a shell in the management container
mgmt:
    docker exec -it g17-mgmt bash

# Stop the management container (everything it needs is kept in this folder)
mgmt-stop:
    docker stop g17-mgmt

# Create the SSH key Terraform installs on the VMs and Ansible logs in with
keygen:
    mkdir -p ssh && test -f ssh/id_ed25519 || ssh-keygen -t ed25519 -N "" -C g17-deploy -f ssh/id_ed25519

# Build the five images for linux/amd64 and push them, e.g. just images docker.io/<user> v1
images registry tag="latest":
    ./build-images.sh {{registry}} {{tag}}

# Create the data disks and the static address, or reuse the ones a previous deployment left (see destroy)
persistent:
    #!/usr/bin/env bash
    set -euo pipefail
    cd terraform/persistent
    terraform init -upgrade
    vars=(-var-file=../terraform.tfvars)
    # Adopt what already exists in the project but not in this folder's state (left by `just destroy`
    # with a lost state, or created by a teammate): import it, so that apply keeps it instead of failing.
    adopt() {  # adopt <resource address> <name in GCP>
        terraform state show "$1" >/dev/null 2>&1 && { echo "$2: already managed here, reusing it"; return; }
        if out=$(terraform import -input=false "${vars[@]}" "$1" "$2" 2>&1); then
            echo "$2: found in the project, reusing it (and the data on it)"
        elif grep -q 'non-existent remote object' <<<"$out"; then
            echo "$2: not in the project yet, creating it"
        else
            echo "$out" >&2; exit 1
        fi
    }
    adopt google_compute_address.edge g17-edge
    # The workers' names (worker1 worker2...): the last line terraform console prints, after any warning.
    workers=$(echo 'jsonencode(local.workers)' | terraform console "${vars[@]}" 2>/dev/null | tail -n 1 | grep -o 'worker[0-9]\+' || true)
    [ -n "$workers" ] || { echo "Couldn't read the number of workers from terraform.tfvars" >&2; exit 1; }
    for w in $workers; do
        adopt "google_compute_disk.data[\"$w\"]" "g17-data-$w"
    done
    terraform apply "${vars[@]}"

# Create the VMs, network and firewall in GCP, attach the data disks, and write ansible/inventory.ini
infra: persistent
    cd terraform && terraform init -upgrade && terraform apply

# Install Kubernetes (containerd, kubeadm, Calico) on the VMs
cluster:
    cd ansible && ansible-playbook playbooks/01-nodes.yml playbooks/02-cluster.yml

# Create the volumes on the data disks, install Strimzi (Kafka operator), Prometheus and Grafana
platform:
    cd ansible && ansible-playbook playbooks/03-platform.yml

# Deploy (or update) the application
app:
    cd ansible && ansible-playbook playbooks/04-app.yml

# Everything, from no VMs to the application running
all: infra cluster platform app

# Open Prometheus at http://localhost:9090: run on your computer, which needs kubectl (Prometheus isn't public)
prometheus:
    kubectl --kubeconfig .kube/config -n monitoring port-forward svc/monitoring-kube-prometheus-prometheus 9090

# Stop every VM: the disks (the data disks hold every volume) and the static address stay, and only those are billed
stop:
    cd terraform && terraform apply -auto-approve -var vm_state=TERMINATED

# Start the VMs again (refreshing the inventory and the kubeconfig) and wait until the application answers
start:
    #!/usr/bin/env bash
    set -euo pipefail
    began=$SECONDS
    # Waits for a command to succeed, for 10 minutes at most.
    wait_for() {
        local deadline=$((SECONDS + 600))
        until "$@" >/dev/null 2>&1; do
            [ $SECONDS -lt $deadline ] || { echo "Gave up waiting for: $*" >&2; exit 1; }
            sleep 5
        done
    }

    # A VM gets its public address when it starts, so Terraform's state has none until after: the first apply
    # only starts the VMs (ansible/inventory.ini, which would change mid-apply, is left out); the second
    # reads their new addresses and rewrites the inventory.
    (cd terraform && terraform apply -auto-approve -var vm_state=RUNNING \
        -target=google_compute_instance.master -target=google_compute_instance.worker)
    (cd terraform && terraform apply -auto-approve -var vm_state=RUNNING)
    master=$(terraform -chdir=terraform output -raw master_ip)
    [ -n "$master" ] || { echo "Terraform has no address for the master: are the VMs running?" >&2; exit 1; }
    url=$(terraform -chdir=terraform output -raw public_url)

    # The API server's certificate names the master's first address, but also "kubernetes": checking it
    # against that name lets kubectl follow the new address.
    kubectl config set-cluster kubernetes --kubeconfig .kube/config \
        --server="https://$master:6443" --tls-server-name=kubernetes

    echo "Waiting for the Kubernetes API, then the nodes..."
    wait_for kubectl get nodes
    kubectl wait --for=condition=Ready nodes --all --timeout=10m

    echo "Waiting for Kafka, the databases and the application..."
    kubectl -n kafka wait pod -l strimzi.io/cluster=movies-kafka --for=condition=Ready --timeout=15m
    for kind in statefulset deployment; do
        kubectl get "$kind" -A --no-headers -o custom-columns=NS:.metadata.namespace,NAME:.metadata.name </dev/null |
        while read -r ns name; do kubectl -n "$ns" rollout status "$kind/$name" --timeout=15m </dev/null; done
    done

    echo "Waiting for $url to answer..."
    wait_for curl -ksf "$url/auth/realms/movies"
    wait_for curl -ksf "$url/"
    echo "Everything answers, $((SECONDS - began)) seconds after the start: $url"

# Record the application's state to evidence/<label>.txt, to compare before and after a stop and start, or a destroy and all
snapshot label:
    ./evidence/snapshot.sh {{label}}

# Compare two snapshots: prints IDENTICAL, or the lines that differ
compare before after:
    ./evidence/compare.sh {{before}} {{after}}

# The data disks and the static address stay (and are billed): the next `just all` reattaches them, and
# the application comes back with all its data.
#
# Delete the VMs, their boot disks and the network, keeping the data (see destroy-data)
destroy:
    #!/usr/bin/env bash
    set -euo pipefail
    cd terraform
    # A deployment made before the persistent stack still has the static address in this state, and
    # destroy ignores the removed block in network.tf: forget it here (just persistent imports it later).
    if terraform state list 2>/dev/null | grep -qx google_compute_address.edge; then
        terraform state rm google_compute_address.edge
    fi
    terraform destroy

# Delete the data disks and the static address too: every database, Kafka, the models and Prometheus are lost
destroy-data:
    #!/usr/bin/env bash
    set -euo pipefail
    if terraform -chdir=terraform state list 2>/dev/null | grep -q '^google_compute_instance'; then
        echo "The VMs still exist and use the disks: run just destroy first." >&2; exit 1
    fi
    cd terraform/persistent && terraform init -upgrade >/dev/null && terraform destroy -var-file=../terraform.tfvars
