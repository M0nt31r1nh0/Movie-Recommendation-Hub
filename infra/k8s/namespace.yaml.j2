# The application's namespace and its secrets. Kafka runs in the kafka namespace (Strimzi), Prometheus
# and Grafana in monitoring.
apiVersion: v1
kind: Namespace
metadata:
  name: movies
---
apiVersion: v1
kind: Secret
metadata:
  name: movies-secrets
  namespace: movies
type: Opaque
stringData:
  keycloak-admin-password: "{{ keycloak_admin_password }}"
  recommendation-service-secret: "{{ recommendation_service_secret }}"
  recommendation-worker-secret: "{{ recommendation_worker_secret }}"
{% for db in databases %}
  {{ db.name }}-password: "{{ lookup('ansible.builtin.password', secrets_dir + '/' + db.name, length=24, chars=secret_chars) }}"
{% endfor %}
{% if image_pull_secret.server %}
---
apiVersion: v1
kind: Secret
metadata:
  name: registry
  namespace: movies
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: "{{ {'auths': {image_pull_secret.server: {'username': image_pull_secret.username, 'password': image_pull_secret.password, 'auth': (image_pull_secret.username + ':' + image_pull_secret.password) | b64encode}}} | to_json | b64encode }}"
{% endif %}
