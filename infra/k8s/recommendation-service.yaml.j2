# recommendation-service: the recommendations API and its background agent. Public at
# {{ public_url }}/api/recommendations (with the /events stream). Queues jobs for the worker in Kafka.
{% set restart_annotation = image_tag == 'latest' %}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: recommendation-service
  namespace: movies
spec:
  replicas: 1
  selector:
    matchLabels:
      app: recommendation-service
  template:
    metadata:
      labels:
        app: recommendation-service
{% if restart_annotation %}
      # The image is "latest": a new value on every deploy makes Kubernetes pull it again.
      annotations:
        movies/deployed-at: "{{ deploy_timestamp }}"
{% endif %}
    spec:
{% if image_pull_secret.server %}
      imagePullSecrets:
        - name: registry
{% endif %}
      containers:
        - name: recommendation-service
          image: "{{ image_registry }}/recommendation-service:{{ image_tag }}"
          imagePullPolicy: Always
          env:
            # Heap at most half the memory limit (run-java.sh's default, 80%, leaves too little for the rest of the JVM).
            - name: JAVA_MAX_MEM_RATIO
              value: "50"
            - name: QUARKUS_DATASOURCE_JDBC_URL
              value: jdbc:postgresql://recommendations-db:5432/recommendations
            - name: QUARKUS_DATASOURCE_USERNAME
              value: recommendations
            - name: QUARKUS_DATASOURCE_PASSWORD
              valueFrom:
                secretKeyRef: { name: movies-secrets, key: recommendations-db-password }
            - name: QUARKUS_OIDC_AUTH_SERVER_URL
              value: "{{ keycloak_realm_url }}"
            - name: QUARKUS_HTTP_CORS_ORIGINS
              value: "{{ public_url }}"
            - name: KEYCLOAK_REALM_URL
              value: "{{ keycloak_realm_url }}"
            - name: RECOMMENDATION_SERVICE_SECRET
              valueFrom:
                secretKeyRef: { name: movies-secrets, key: recommendation-service-secret }
            - name: KAFKA_BOOTSTRAP_SERVERS
              value: "{{ kafka_bootstrap_servers }}"
            - name: QUARKUS_REST_CLIENT_PROFILES_API_URL
              value: http://profiles-service:8080
            - name: QUARKUS_REST_CLIENT_MOVIES_API_URL
              value: http://movies-service:8080
          ports:
            - name: http
              containerPort: 8080
          # Liveness only says the JVM is up; readiness also that its database, Kafka (or Ollama) answer.
          startupProbe:
            httpGet: { path: /q/health/started, port: http }
            periodSeconds: 5
            failureThreshold: 36
          readinessProbe:
            httpGet: { path: /q/health/ready, port: http }
            periodSeconds: 10
          livenessProbe:
            httpGet: { path: /q/health/live, port: http }
            periodSeconds: 20
          resources:
            requests: { cpu: 100m, memory: 384Mi }
            limits: { memory: 768Mi }
---
# Its metrics are at /q/metrics on the same port, scraped by Prometheus (monitoring.yaml.j2), but never
# routed by NGINX.
apiVersion: v1
kind: Service
metadata:
  name: recommendation-service
  namespace: movies
  labels:
    app: recommendation-service
    movies/monitor: quarkus
spec:
  selector:
    app: recommendation-service
  ports:
    - name: http
      port: 8080
