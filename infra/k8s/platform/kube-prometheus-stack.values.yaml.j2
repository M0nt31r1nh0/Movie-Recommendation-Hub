# kube-prometheus-stack's settings (rendered by ansible/playbooks/03-platform.yml).

# No alerting in this project.
alertmanager:
  enabled: false

# kubeadm binds these control-plane components' metrics to 127.0.0.1, out of Prometheus' reach: without
# this, their targets show as down.
kubeEtcd:
  enabled: false
kubeControllerManager:
  enabled: false
kubeScheduler:
  enabled: false
kubeProxy:
  enabled: false

prometheus:
  prometheusSpec:
    # Pick up every ServiceMonitor and PodMonitor in any namespace, not only the chart's own
    # (the application's are in k8s/monitoring.yaml.j2).
    serviceMonitorSelectorNilUsesHelmValues: false
    podMonitorSelectorNilUsesHelmValues: false
    ruleSelectorNilUsesHelmValues: false
    scrapeInterval: 15s
    retention: 7d
    resources:
      requests: { cpu: 200m, memory: 512Mi }
      limits: { memory: 1536Mi }
    # Its claim is data-prometheus-monitoring-kube-prometheus-prometheus-0, which has a volume on a
    # worker's data disk (persistent_volumes in ansible/group_vars/all.yml).
    storageSpec:
      volumeClaimTemplate:
        metadata:
          name: data
        spec:
          accessModes: [ReadWriteOnce]
          storageClassName: {{ storage_class }}
          resources:
            requests:
              storage: 10Gi

grafana:
  # Only used when Grafana creates its database: kept in ansible/.secrets/ as long as the data disk.
  adminPassword: "{{ grafana_admin_password }}"
  # Its database (SQLite: users, preferences, anything made in the UI) on a worker's data disk, as
  # monitoring/monitoring-grafana (persistent_volumes in ansible/group_vars/all.yml). Recreate: never two
  # Grafanas on the same file during an update.
  persistence:
    enabled: true
    type: pvc
    storageClassName: {{ storage_class }}
    accessModes: [ReadWriteOnce]
    size: 2Gi
  deploymentStrategy:
    type: Recreate
  # Served by NGINX at {{ public_url }}/grafana/.
  grafana.ini:
    server:
      root_url: "{{ public_url }}/grafana/"
      serve_from_sub_path: true
  # Under the sub-path, Grafana's own metrics move too (/metrics redirects to the public URL).
  serviceMonitor:
    path: /grafana/metrics
  # Loki (k8s/platform/loki.yaml.j2), for the logs: Explore, and the Logs row of the Movies dashboard,
  # which finds it by this uid.
  additionalDataSources:
    - name: Loki
      uid: loki
      type: loki
      access: proxy
      url: http://loki.monitoring.svc.cluster.local:3100
  # Dashboards come from ConfigMaps labelled grafana_dashboard=1, in any namespace (the application's
  # is created by ansible/playbooks/04-app.yml from k8s/dashboards/).
  sidecar:
    dashboards:
      enabled: true
      label: grafana_dashboard
      labelValue: "1"
      searchNamespace: ALL
